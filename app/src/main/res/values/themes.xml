<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MugaruTv" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/school_starting_background</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/school_starting_background</item>
        <item name="windowSplashScreenBackground">#EEE9E0</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.MugaruTv</item>
    </style>
</resources>
